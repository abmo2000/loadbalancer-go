# Load balancer configuration values. Copy to .env and adjust as needed.
LB_LISTEN_ADDR=:8080
# Listen address for the load balancer. Default: :8080
LB_BACKENDS=http://localhost:9001,http://localhost:9002,http://localhost:9003
# Comma-separated backend URLs. Default: http://localhost:9001,http://localhost:9002,http://localhost:9003
# Per-backend example: http://localhost:9001;health_path=/healthz;health_interval=2s;health_timeout=500ms,http://localhost:9002;health_path=/ping
LB_HEALTH_INTERVAL=5s
# Health check interval. Default: 5s
LB_HEALTH_TIMEOUT=2s
# Health check HTTP client timeout. Default: 2s
LB_HEALTH_FAIL_THRESHOLD=3
# Consecutive failures before a backend is marked dead. Default: 3
LB_HEALTH_RISE_THRESHOLD=2
# Consecutive successful active checks before a dead backend recovers. Default: 2
LB_HEALTH_PATH=/
# Path requested by active health checks. Default: /
LB_FLAP_WINDOW=60s
# Sliding window for backend state transitions. Default: 60s
LB_FLAP_MAX_TRANSITIONS=4
# Transitions within the window before quarantine; 0 disables. Default: 4
LB_QUARANTINE_BASE=30s
# Initial quarantine hold-down. Default: 30s
LB_QUARANTINE_MAX=5m
# Maximum quarantine hold-down. Default: 5m
LB_QUARANTINE_RESET_AFTER=5m
# Alive duration with no transitions before resetting quarantine level. Default: 5m
LB_MAX_QUARANTINE_PERCENT=50
# Maximum percentage of backends quarantined at once. Default: 50
LB_DIAL_TIMEOUT=3s
# Backend dial timeout. Default: 3s
LB_RESPONSE_TIMEOUT=10s
# Backend response header timeout. Default: 10s
LB_READ_HEADER_TIMEOUT=5s
# HTTP server read-header timeout. Default: 5s
LB_READ_TIMEOUT=15s
# HTTP server read timeout. Default: 15s
LB_WRITE_TIMEOUT=30s
# HTTP server write timeout. Default: 30s
LB_IDLE_TIMEOUT=60s
# HTTP server idle timeout. Default: 60s
LB_SHUTDOWN_TIMEOUT=15s
# Time allowed for graceful shutdown. Default: 15s
LB_CHECK_ONLY=false
# Validate and preflight configuration, then exit. Default: false
